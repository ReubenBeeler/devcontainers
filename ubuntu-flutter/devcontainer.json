// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Ubuntu Flutter",
	// Pre-built image — see Dockerfile and scripts/rebuild-and-push.sh
	// "image": "mcr.microsoft.com/devcontainers/base:noble",
	"image": "localhost:5001/ubuntu-flutter:latest",
	"features": {
		"ghcr.io/hwaien/devcontainer-features/match-host-time-zone": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
		// Locks shared with the host and the other containers, so concurrent
		// starts cannot race over host-global state such as the one ADB server
		// on port 5037.  Created by initialize.sh.
		"source=${localEnv:HOME}/.cache/devcontainer-locks,target=/var/lock/devcontainer,type=bind"
	],
	// One pinned D-Bus session bus for every process in the container, so the
	// gnome-keyring unlocked by postStart.sh is the one libsecret clients
	// (e.g. supabase login) actually reach. See scripts/setup-dbus-keyring.sh.
	"containerEnv": {
		"DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/dbus-session"
	},
	"runArgs": [
		"--network=host",
		"--device=/dev/kvm",
		"--device-cgroup-rule=c 189:* rwm",
		"--volume=/dev/bus/usb:/dev/bus/usb",
		"--volume=/sys/bus:/sys/bus:ro",
		"--volume=/sys/devices:/sys/devices:rw",
		"--security-opt=apparmor=unconfined"
	],
	// Supabase ports are served by Docker-in-Docker inside the container, so
	// VS Code port-forwarding is not needed.  "ignore" prevents VS Code from
	// claiming these ports after supabase stops, which blocks the next start.
	// 8089 is SRH (Redis REST API) — same story: the backend tests reach it at
	// localhost:8089 from inside the container, so it must be published by
	// docker but never forwarded out.  If the forwarder wins the race,
	// start-redis.sh dies with "address already in use", SRH never starts, and
	// the forwarder still accepts the tests' connections without answering —
	// hanging the suite instead of failing it.
	"portsAttributes": {
		"8089": { "onAutoForward": "ignore" },
		"54320": { "onAutoForward": "ignore" },
		"54321": { "onAutoForward": "ignore" },
		"54322": { "onAutoForward": "ignore" },
		"54323": { "onAutoForward": "ignore" },
		"54324": { "onAutoForward": "ignore" },
		"54325": { "onAutoForward": "ignore" },
		"54326": { "onAutoForward": "ignore" },
		"54327": { "onAutoForward": "ignore" },
		"54328": { "onAutoForward": "ignore" },
		"54329": { "onAutoForward": "ignore" }
	},
	"initializeCommand": "bash .devcontainer/ubuntu-flutter/initialize.sh",
	"postCreateCommand": "bash .devcontainer/ubuntu-flutter/postCreate.sh",
	"postStartCommand": "bash .devcontainer/ubuntu-flutter/postStart.sh",
	"customizations": {
		"vscode": {
			// This container runs --network=host, so it shares ONE network
			// namespace with the host: every port a service binds inside the
			// container is already reachable at localhost on the host, and
			// forwarding is not merely redundant but actively broken.  VS Code
			// forwards container port N to local port N -- the same address --
			// so the tunnel's own listener becomes what its other end dials.
			// The result is a socket that accepts connections and never answers
			// (a black hole), and which squats the port so docker can no longer
			// publish it: start-redis.sh then dies with "address already in use"
			// and SRH never starts.
			//
			// The per-port "ignore" entries in portsAttributes were whack-a-mole
			// against this (8089 was simply never added).  Turning the feature
			// off fixes the whole class.  Ports stay reachable exactly as before:
			// the host hits Supabase directly at localhost:54321 (same netns),
			// and a USB device reaches it via `adb reverse`, which tunnels over
			// the adb socket — neither path ever used VS Code forwarding.  This
			// only disables AUTO-forwarding; the Ports view "Forward a Port"
			// button still works if a manual forward is ever wanted.
			"settings": {
				"remote.autoForwardPorts": false
			},
			"extensions": [
				"astro-build.astro-vscode",
				"mhutchie.git-graph",
				"github.vscode-github-actions",
				"mads-hartmann.bash-ide-vscode",
				"ms-azuretools.vscode-docker",
				"github.github-vscode-theme",
				"tomoki1207.pdf",
				"repreng.csv",
				"esbenp.prettier-vscode",
				"dart-code.dart-code",
				"dart-code.flutter",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff"
			]
		}
	}
}