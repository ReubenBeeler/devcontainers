// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	"features": {
		"ghcr.io/hwaien/devcontainer-features/match-host-time-zone": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"mounts": [
		"source=${localEnv:HOME}/.claude/.credentials.json,target=/home/vscode/.claude/.credentials.json,type=bind,consistency=cached"
	],
	// One pinned D-Bus session bus for every process in the container, so the
	// gnome-keyring unlocked by postStart.sh is the one libsecret clients
	// (e.g. supabase login) actually reach. See scripts/setup-dbus-keyring.sh.
	"containerEnv": {
		"DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/dbus-session"
	},
	// Supabase ports are served by Docker-in-Docker inside the container, so
	// VS Code port-forwarding is not needed.  "ignore" prevents the host from
	// claiming these ports when nothing is actively listening on them.
	// 8089 is SRH (Redis REST API), which the backend tests reach at
	// localhost:8089 from inside the container: it must be published by docker
	// but never forwarded out.  If the forwarder claims it first, start-redis.sh
	// dies with "address already in use" and SRH never starts.
	"portsAttributes": {
		"8089": { "onAutoForward": "ignore" },
		"54321": { "onAutoForward": "ignore" },
		"54322": { "onAutoForward": "ignore" },
		"54323": { "onAutoForward": "ignore" },
		"54324": { "onAutoForward": "ignore" },
		"54327": { "onAutoForward": "ignore" }
	},
	// lifecycle scripts
	"initializeCommand": "bash .devcontainer/ubuntu/hostConfig.sh",
	"postCreateCommand": "bash .devcontainer/ubuntu/postCreate.sh",
	"postStartCommand": "bash .devcontainer/ubuntu/postStart.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"astro-build.astro-vscode",
				"mhutchie.git-graph",
				"github.vscode-github-actions",
				"mads-hartmann.bash-ide-vscode",
				"ms-azuretools.vscode-docker",
				"github.github-vscode-theme",
				"tomoki1207.pdf",
				"repreng.csv",
				"esbenp.prettier-vscode"
			]
		}
	}
}